# ──────────────────────────────────────────────────────────────────────────────
#  minecraft-manager — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# Your Discord user ID (right-click yourself → Copy User ID with Developer Mode on)
OWNER_ID=your-discord-user-id-here

# AES-256-GCM encryption key for database.json
# Must be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ENCRYPTION_KEY=replace-me-with-96-hex-chars-minimum

# Minecraft server to connect to
MC_HOST=play.yourserver.net
MC_PORT=25565
